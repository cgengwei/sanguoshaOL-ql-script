# 使用支持 ARM64 (Mac M4) 的青龙基础镜像 (Debian 版)
FROM whyour/qinglong:debian

USER root

# 替换为国内镜像源 (Debian Bookworm) 以加速安装
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources || true \
    && sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list || true \
    && sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list || true

# 安装 X11, VNC, noVNC 和浏览器所需的依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    fluxbox \
    novnc \
    websockify \
    chromium \
    chromium-driver \
    fonts-wqy-zenhei \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libgbm1 \
    libasound2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxtst6 \
    libxrender1 \
    libxss1 \
    libxshmfence1 \
    libwayland-client0 \
    libwayland-server0 \
    libpangocairo-1.0-0 \
    libpango-1.0-0 \
    libgtk-3-0 \
    xterm \
    && rm -rf /var/lib/apt/lists/*

# 创建 noVNC 的入口 (使用 cp 替代 ln -s 以防 websockify 不支持软链)
RUN cp /usr/share/novnc/vnc.html /usr/share/novnc/index.html

# 暴露端口: 5700 (青龙Web), 6080 (VNC 监控 Web 界面)
EXPOSE 5700 6080

# 复制启动配置
COPY docker/start-vnc.sh /usr/local/bin/start-vnc.sh
RUN chmod +x /usr/local/bin/start-vnc.sh

# 设置环境变量
ENV DISPLAY=:99
ENV HEADLESS=false
ENV CHROME_BIN=/usr/bin/chromium
ENV NODE_PATH=/usr/local/lib/node_modules

# 预安装 Playwright 核心依赖 (可选，方便脚本直接运行)
RUN npm install -g playwright playwright-chromium

# 使用自定义脚本作为启动入口，以支持有头模式所需的 VNC 环境
ENTRYPOINT ["/usr/local/bin/start-vnc.sh"]
